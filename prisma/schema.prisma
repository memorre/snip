// Snip — short link platform with analytics

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  links Link[]
}

model Link {
  id        String    @id @default(cuid())
  slug      String    @unique
  targetUrl String
  title     String?
  ownerId   String
  disabled  Boolean   @default(false)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clicks Click[]

  @@index([ownerId])
}

model Click {
  id         String      @id @default(cuid())
  linkId     String
  createdAt  DateTime    @default(now())
  referrer   String?
  userAgent  String?
  browser    String?
  os         String?
  deviceType DeviceType  @default(OTHER)
  country    String?
  city       String?

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([linkId, createdAt])
}
